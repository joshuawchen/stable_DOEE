{
  "comment": "Spec fixture corpus shared with the oops fork. Each case is a full non gaussian cost mapping (C++ key names) plus the expected outcome of NonGaussianDensity::validate(). check_fixtures.py asserts the python mirror (doee_to_yaml.validate_spec) agrees; a C++ consumer asserting the same is queued for the next fork build session. The reject cases match the validate_rejects unit test in src/test/assimilation/NonGaussianDensity.h.",
  "cases": [
    {"name": "valid base",
     "expect": "accept",
     "spec": {"mode": 0.0, "grid spacing": 0.5, "stable min": -2.0, "stable max": 2.0,
              "log slopes": [1.0, 0.8, 0.5, 0.2, -0.2, -0.5, -0.8, -1.0],
              "left log slope": 1.0, "left curvature": -0.4,
              "right log slope": -1.0, "right curvature": -0.5,
              "sigma at mode": 1.2}},
    {"name": "valid shifted mode",
     "expect": "accept",
     "spec": {"mode": 0.75, "grid spacing": 0.5, "stable min": -2.0, "stable max": 2.0,
              "log slopes": [1.375, 1.125, 0.875, 0.625, 0.375, 0.125, -0.125, -0.375],
              "left log slope": 1.375, "left curvature": -0.5,
              "right log slope": -0.625, "right curvature": -0.5,
              "sigma at mode": 1.4142135623730951}},
    {"name": "slope count vs extent mismatch",
     "expect": "reject",
     "spec": {"mode": 0.0, "grid spacing": 0.5, "stable min": -2.0, "stable max": 1.5,
              "log slopes": [1.0, 0.8, 0.5, 0.2, -0.2, -0.5, -0.8, -1.0],
              "left log slope": 1.0, "left curvature": -0.4,
              "right log slope": -1.0, "right curvature": -0.5,
              "sigma at mode": 1.2}},
    {"name": "growing right tail",
     "expect": "reject",
     "spec": {"mode": 0.0, "grid spacing": 0.5, "stable min": -2.0, "stable max": 2.0,
              "log slopes": [1.0, 0.8, 0.5, 0.2, -0.2, -0.5, -0.8, -1.0],
              "left log slope": 1.0, "left curvature": -0.4,
              "right log slope": -1.0, "right curvature": 0.5,
              "sigma at mode": 1.2}},
    {"name": "mode outside the stable interior",
     "expect": "reject",
     "spec": {"mode": 3.0, "grid spacing": 0.5, "stable min": -2.0, "stable max": 2.0,
              "log slopes": [1.0, 0.8, 0.5, 0.2, -0.2, -0.5, -0.8, -1.0],
              "left log slope": 1.0, "left curvature": -0.4,
              "right log slope": -1.0, "right curvature": -0.5,
              "sigma at mode": 1.2}},
    {"name": "negative slope below the mode",
     "expect": "reject",
     "spec": {"mode": 0.0, "grid spacing": 0.5, "stable min": -2.0, "stable max": 2.0,
              "log slopes": [1.0, -0.8, 0.5, 0.2, -0.2, -0.5, -0.8, -1.0],
              "left log slope": 1.0, "left curvature": -0.4,
              "right log slope": -1.0, "right curvature": -0.5,
              "sigma at mode": 1.2}},
    {"name": "positive slope above the mode",
     "expect": "reject",
     "spec": {"mode": 0.0, "grid spacing": 0.5, "stable min": -2.0, "stable max": 2.0,
              "log slopes": [1.0, 0.8, 0.5, 0.2, -0.2, 0.5, -0.8, -1.0],
              "left log slope": 1.0, "left curvature": -0.4,
              "right log slope": -1.0, "right curvature": -0.5,
              "sigma at mode": 1.2}},
    {"name": "nonpositive sigma at mode",
     "expect": "reject",
     "spec": {"mode": 0.0, "grid spacing": 0.5, "stable min": -2.0, "stable max": 2.0,
              "log slopes": [1.0, 0.8, 0.5, 0.2, -0.2, -0.5, -0.8, -1.0],
              "left log slope": 1.0, "left curvature": -0.4,
              "right log slope": -1.0, "right curvature": -0.5,
              "sigma at mode": 0.0}}
  ]
}
