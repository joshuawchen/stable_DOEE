+/*
+ * (C) Copyright 2026 Colorado State University
+ *
+ * This software is licensed under the terms of the Apache Licence Version 2.0
+ * which can be obtained at http://www.apache.org/licenses/LICENSE-2.0.
+ */
+
+/*
+ * EVALUATION-PARITY test for the Format A interface: the density this
+ * evaluator computes must be NUMERICALLY the density the stable_DOEE
+ * Python exporter produced. The fixtures (test/testinput/
+ * parity_fixtures.json) are generated by stable_DOEE
+ * jedi_export/make_parity_fixtures.py from the ANALYTIC menu densities
+ * (gaussian, heavy, skewed, laplace) -- deterministic, byte-stable, no
+ * estimation noise -- with 23 reference points per density covering
+ * every evaluator branch: deep tails, both tail junctions, interior
+ * bins (at bin fraction 0.37, never on an edge), and the mode window
+ * (the variance fallback). Regenerate THERE, copy HERE; the Python
+ * side's --check keeps the source of truth pinned.
+ *
+ * The fixtures file is passed as the test configuration (JSON is valid
+ * YAML for eckit). Comparison: |got - ref| <= tol * (1 + |ref|), tol
+ * from the file (1e-9), covering exact zeros at the mode and O(10)
+ * tail scores alike.
+ */
+
+#ifndef TEST_ASSIMILATION_FORMATAPARITY_H_
+#define TEST_ASSIMILATION_FORMATAPARITY_H_
+
+#include <cmath>
+#include <string>
+#include <vector>
+
+#include "eckit/config/LocalConfiguration.h"
+#include "eckit/testing/Test.h"
+
+#include "oops/../test/TestEnvironment.h"
+#include "oops/assimilation/NonGaussianDensity.h"
+#include "oops/runs/Test.h"
+#include "oops/util/Expect.h"
+#include "oops/util/Logger.h"
+
+namespace test {
+
+CASE("assimilation/FormatAParity/cases") {
+  const eckit::Configuration & top = TestEnvironment::config();
+  const double tol = top.getDouble("tol");
+  const auto cases = top.getSubConfigurations("cases");
+  EXPECT(cases.size() >= 4);
+  for (const auto & cc : cases) {
+    const std::string name = cc.getString("name");
+    oops::NonGaussianDensityParameters params;
+    params.deserialize(cc.getSubConfiguration("spec"));
+    const oops::NonGaussianDensity den(params);
+    const eckit::LocalConfiguration ref(cc, "reference");
+    const std::vector<double> d = ref.getDoubleVector("d");
+    const std::vector<double> score = ref.getDoubleVector("score");
+    const std::vector<double> variance = ref.getDoubleVector("variance");
+    EXPECT_EQUAL(d.size(), score.size());
+    EXPECT_EQUAL(d.size(), variance.size());
+    for (size_t i = 0; i < d.size(); ++i) {
+      const double gs = den.score(d[i]);
+      const double gv = den.evolvingVariance(d[i]);
+      if (std::abs(gs - score[i]) > tol * (1.0 + std::abs(score[i]))) {
+        oops::Log::info() << "FormatAParity " << name << " score mismatch at d="
+                          << d[i] << ": got " << gs << " ref " << score[i]
+                          << std::endl;
+      }
+      if (std::abs(gv - variance[i]) > tol * (1.0 + std::abs(variance[i]))) {
+        oops::Log::info() << "FormatAParity " << name << " variance mismatch at d="
+                          << d[i] << ": got " << gv << " ref " << variance[i]
+                          << std::endl;
+      }
+      EXPECT(std::abs(gs - score[i]) <= tol * (1.0 + std::abs(score[i])));
+      EXPECT(std::abs(gv - variance[i]) <= tol * (1.0 + std::abs(variance[i])));
+    }
+  }
+}
+
+class FormatAParity : public oops::Test {
+ public:
+  using oops::Test::Test;
+ private:
+  std::string testid() const override {return "test::FormatAParity";}
+  void register_tests() const override {}
+  void clear() const override {}
+};
+
+}  // namespace test
+
+#endif  // TEST_ASSIMILATION_FORMATAPARITY_H_
